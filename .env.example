# Database (Hostinger managed MySQL in prod, local/dev MySQL locally)
DATABASE_URL="mysql://user:password@localhost:3306/studievagledare"

# Sessions (iron-session) — generate with: openssl rand -hex 32
SESSION_SECRET=""

# Anthropic API — never expose to the client, server-side only
ANTHROPIC_API_KEY=""
AI_MODEL_INTERVIEW="claude-haiku-4-5-20251001"
AI_MODEL_REPORT="claude-sonnet-5"
AI_DAILY_BUDGET_SEK="200"
AI_MAX_TOKENS_PER_INTERVIEW="60000"
AI_KILL_SWITCH="false"

# Set to "mock" to skip the real Anthropic API entirely (free, canned
# replies — see src/lib/ai/mock.ts). Good for testing the chat UI/engine/DB
# plumbing; says nothing about real conversation quality. Leave unset (or
# any other value) to call Anthropic for real. ANTHROPIC_API_KEY is not
# required when this is "mock".
AI_PROVIDER=""

# Cross-product handoff (studiecoach.ai)
HANDOFF_SHARED_SECRET=""
STUDIECOACH_BASE_URL="https://studiecoach.ai"

# Cron-protected HTTP endpoints, if used instead of direct tsx invocation
CRON_SECRET=""

APP_BASE_URL="http://localhost:3000"
